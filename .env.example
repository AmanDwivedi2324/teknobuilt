# Copy this file to .env and fill in your values. .env is git-ignored; never commit real keys.

# Google AI Studio key (https://aistudio.google.com -> Get API key). Leave empty to run without a model:
# text fields then come back empty and every page is marked needs_review.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_MAX_ATTEMPTS=4
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_CONCURRENCY=2
# LLM_SEND_WIDTH_PX=1240
# RENDER_DPI=200
# MAX_WORKERS=4
# CACHE_DIR=output/cache
# LOG_LEVEL=INFO
